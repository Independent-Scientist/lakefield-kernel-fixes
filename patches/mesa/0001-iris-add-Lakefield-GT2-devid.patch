--- a/include/pci_ids/iris_pci_ids.h
+++ b/include/pci_ids/iris_pci_ids.h
@@ -144,6 +144,12 @@
 CHIPSET(0x4557, ehl_4x5, "EHL", "Intel(R) UHD Graphics")
 CHIPSET(0x4570, ehl_4x8, "EHL", "Intel(R) UHD Graphics")
 CHIPSET(0x4571, ehl_4x8, "EHL", "Intel(R) UHD Graphics")
+
+/* Lakefield GT2 (8086:9840) — Gen11 LP, 64 EU. Not in upstream Mesa; mapped to
+ * ICL GT2 because that is the family whose topology (64 EU, Gen11 GT2) matches
+ * the silicon. Flipping this to ehl_2x8 is a one-line change if ICL workarounds
+ * turn out wrong for the LP part. */
+CHIPSET(0x9840, icl_gt2, "LKF GT2", "Intel(R) UHD Graphics")
 CHIPSET(0x4e51, ehl_4x4, "JSL", "Intel(R) UHD Graphics")
 CHIPSET(0x4e55, ehl_2x8, "JSL", "Intel(R) UHD Graphics")
 CHIPSET(0x4e57, ehl_4x5, "JSL", "Intel(R) UHD Graphics")
